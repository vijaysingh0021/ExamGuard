# PostgreSQL. Server-only: never expose this value to the client.
DATABASE_URL=postgresql://examguard:examguard_dev@localhost:5432/examguard
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Private S3-compatible document storage; never expose these server-only credentials.
OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=sentinelexam-private
OBJECT_STORAGE_ACCESS_KEY_ID=<access-key>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<secret>
# Optional outbound email provider. In-app notifications work without these values.
EMAIL_URL=https://api.<provider>/send
EMAIL_FROM=no-reply@example.edu
EMAIL_PROVIDER=webhook
# OAuth/OIDC: register these exact callback URLs with each provider:
# ${API_BASE_URL}/api/auth/oauth/google/callback and
# ${API_BASE_URL}/api/auth/oauth/microsoft/callback. Keep secrets server-only.
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
MICROSOFT_CLIENT_ID=<microsoft-client-id>
MICROSOFT_CLIENT_SECRET=<microsoft-client-secret>
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=<apple-service-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY=<apple-private-key>
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>
# Optional FastAPI analysis service URL. The dashboard/API must report it unavailable until deployed.
AI_SERVICE_URL=http://localhost:8000
