});

// Test 9: File exceeding 5 MB - should be rejected by Multer with 413 or 400
test('evidence upload - oversized file rejection', async () => {
  storageCalls = [];
  const testStorage: StorageInterface = {
    putPrivateDocument: async (key: string, body: Buffer, contentType: string) => { storageCalls.push({ key, contentType }); return `mocked://${key}`; },
    privateDocumentUrl: async (key: string) => `mocked://${key}`,
    storageConfigured: () => true
  };

  const app = createApp(testStorage);
  const server = http.createServer(app);
  await new Promise<void>((resolve, reject) => {
    server.listen(TEST_PORT, (err?: Error) => err ? reject(err) : resolve());
  });

  try {
    const token = signToken(TEST_USER_ID);
    const { body, contentType } = createMultipartBody({}, {
      name: 'file',
      filename: 'evidence.jpg',
      contentType: 'image/jpeg',
      buffer: LARGE_FILE
    });

    const { status } = await makeRequest(
      `/api/student/attempts/${TEST_ATTEMPT_ID}/evidence`,
      'POST',
      { authorization: `Bearer ${token}`, 'Content-Type': contentType },
      body
    );

    // Multer should reject oversized files with 413 (Payload Too Large) or 400
    assert.ok(status === 413 || status === 400, `Expected 413 or 400, got ${status}`);
    assert.equal(storageCalls.length, 0, 'Rejected uploads must never invoke private storage');
  } finally {
    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
  }
});

// Test 10: Malformed multipart request - should be rejected
test('evidence upload - malformed multipart rejection', async () => {
  storageCalls = [];
  const testStorage: StorageInterface = {
    putPrivateDocument: async (key: string, body: Buffer, contentType: string) => { storageCalls.push({ key, contentType }); return `mocked://${key}`; },
    privateDocumentUrl: async (key: string) => `mocked://${key}`,
    storageConfigured: () => true
  };

  const app = createApp(testStorage);
  const server = http.createServer(app);
  await new Promise<void>((resolve, reject) => {
    server.listen(TEST_PORT, (err?: Error) => err ? reject(err) : resolve());
  });

  try {
    const token = signToken(TEST_USER_ID);
    const { status } = await makeRequest(
      `/api/student/attempts/${TEST_ATTEMPT_ID}/evidence`,
      'POST',
      {
        authorization: `Bearer ${token}`,
        'Content-Type': 'multipart/form-data; boundary=invalid-boundary'
      },
      Buffer.from('not a valid multipart body')
    );

    // Should be rejected (400 or 415) - malformed request
    assert.ok(status === 400 || status === 415, `Expected 400 or 415, got ${status}`);
    assert.equal(storageCalls.length, 0, 'Rejected uploads must never invoke private storage');
  } finally {
    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
  }
});


