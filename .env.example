# PostgreSQL. Server-only: never expose this value to the client.
DATABASE_URL=postgresql://examguard:examguard_dev@localhost:5432/examguard
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Private S3-compatible document storage; never expose these server-only credentials.
OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=sentinelexam-private
OBJECT_STORAGE_ACCESS_KEY_ID=<access-key>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<secret>
# Optional outbound email provider. In-app notifications work without email.
# For local SMTP, set EMAIL_PROVIDER=smtp and configure SMTP_* plus MAIL_FROM.
# For Render, use EMAIL_PROVIDER=brevo, EMAIL_API_KEY and MAIL_FROM; do not use SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.edu
# Optional webhook provider; EMAIL_FROM is used only by this provider.
EMAIL_URL=
EMAIL_FROM=
EMAIL_PROVIDER=smtp
# OAuth/OIDC: register these exact callback URLs with each provider:
# ${API_BASE_URL}/api/auth/oauth/google/callback and
# ${API_BASE_URL}/api/auth/oauth/microsoft/callback. Keep secrets server-only.
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
MICROSOFT_CLIENT_ID=<microsoft-client-id>
MICROSOFT_CLIENT_SECRET=<microsoft-client-secret>
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=<apple-service-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY=<apple-private-key>
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>
# Required for secure examination readiness. Local development uses localhost HTTP;
# production requires a network-accessible HTTPS AI service. Keep the token identical
# in both server-side services and never expose it to browser code.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
# Optional Python executable override for the local AI service. Defaults to ai-service/.venv.
# AI_SERVICE_PYTHON=
# Optional Judge0. Configure exactly one authentication mode.
# Self-hosted or standard Judge0-compatible instance:
JUDGE0_BASE_URL=
JUDGE0_AUTH_TOKEN=
# RapidAPI Judge0 CE mode (requires HTTPS; source code and execution inputs are sent to RapidAPI):
JUDGE0_RAPIDAPI_KEY=
# For HTTP only on a trusted private network, explicitly confirm the boundary.
JUDGE0_PRIVATE_HTTP_CONFIRMED=false
# Optional custom standard-Judge0 auth header name and language IDs:
# JUDGE0_AUTH_HEADER_NAME=X-Auth-Token
# JUDGE0_LANGUAGE_ID_C=50
# JUDGE0_LANGUAGE_ID_CPP=54
# JUDGE0_LANGUAGE_ID_JAVA=62
# JUDGE0_LANGUAGE_ID_PYTHON=71
# JUDGE0_LANGUAGE_ID_JAVASCRIPT=63
# Provisional RSSI zone boundaries (dBm); calibrate with the actual radios and venue before use.
RADIO_BLE_NEAR_DBM=-65
RADIO_BLE_MEDIUM_DBM=-80
RADIO_WIFI_NEAR_DBM=-55
RADIO_WIFI_MEDIUM_DBM=-70

# --- Background jobs (durable queue, PostgreSQL-backed) ---
# Set to false to stop this instance from running jobs (e.g. a read-only replica).
BACKGROUND_JOBS_ENABLED=true
# Days after which evidence is REPORTED to administrators as past retention. Nothing is deleted automatically. Leave empty to disable.
EVIDENCE_RETENTION_DAYS=

# --- Assistant (optional; the built-in help center works without any of these) ---
# OpenAI-compatible endpoint. Local endpoints (localhost, 127.0.0.1, host.docker.internal) are allowed by default.
ASSISTANT_PROVIDER_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
# Required for any NON-local provider: confirms your organization approved sending redacted prompts to it.
ASSISTANT_EXTERNAL_DATA_POLICY_APPROVED=false

# --- Email (optional; without it notifications stay in-app only and nothing is queued) ---
# EMAIL_PROVIDER=webhook, EMAIL_URL (HTTPS, or localhost HTTP for development) and EMAIL_FROM are required to enable email.
# EMAIL_API_KEY is sent as Bearer auth for webhook mode and as the Brevo api-key header in Brevo mode.
# For Brevo, MAIL_FROM must exactly match an active, verified sender in your Brevo account.
# Keep real values in your untracked .env only.
EMAIL_API_KEY=
# Public base URL of this API, used for one-click unsubscribe links in emails (leave empty to omit the link).
PUBLIC_API_URL=

# --- Evidence capacity ---
# Optional per-organization evidence quota in MB. When full, NEW uploads are rejected (HTTP 507); nothing is deleted.
EVIDENCE_ORG_QUOTA_MB=
# Local development only: keep captured evidence on this machine. Disabled in production.
# This prototype does not automatically delete these image files; apply your institution retention schedule.
LOCAL_EVIDENCE_DIR=./.local-evidence
